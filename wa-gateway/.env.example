# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_wa_gateway_2026_change_me
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database (Shared with Laravel)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hospital
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration (BullMQ Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Broadcasting Settings
DEFAULT_DELAY_MIN_MS=1500
DEFAULT_DELAY_MAX_MS=4000
QUEUE_CONCURRENCY=3

# Webhook (Global default fallback if device webhook not set)
DEFAULT_LARAVEL_WEBHOOK=http://localhost:8000/api/wa/webhook
